    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "socialDescription": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "socialDescription"
      ],
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "githubLabel": {
          "type": "string"
        },
        "githubUrl": {
          "type": "string",
          "format": "uri"
        },
        "linkedinUrl": {
          "type": "string",
          "format": "uri"
        },
        "websiteUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "role",
        "phone",
        "email",
        "githubLabel",
        "githubUrl",
        "linkedinUrl",
        "websiteUrl"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "education": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        }
      },
      "required": [
        "date"
      ],
      "additionalProperties": false
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "company",
          "role",
          "date",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "wide": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tech": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "repo": {
            "type": "string",
            "format": "uri"
          },
          "proof": {
            "type": "string",
            "format": "uri"
          },
          "proofType": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "tech",
          "category",
          "description",
          "repo"
        ],
        "additionalProperties": false
      }
    },
    "archive": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "year"
        ],
        "additionalProperties": false
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "credentialId": {
            "type": "string"
          },
          "inPreparation": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "issuer",
          "date"
        ],
        "additionalProperties": false
      }
    },
    "pdf": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+\\.pdf$"
        },
        "title": {
          "type": "string"
        },
        "profileHeading": {
          "type": "string"
        },
        "experienceHeading": {
          "type": "string"
        },
        "skillsHeading": {
          "type": "string"
        },
        "projectsHeading": {
          "type": "string"
        },
        "credentialsHeading": {
          "type": "string"
        },
        "includeArchive": {
          "type": "boolean"
        },
        "includeInterests": {
          "type": "boolean"
        }
      },
      "required": [
        "filename",
        "title",
        "profileHeading",
        "experienceHeading",
        "skillsHeading",
        "projectsHeading",
        "credentialsHeading",
        "includeArchive",
        "includeInterests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "language",
    "text",
    "metadata",
    "person",
    "profile",
    "education",
    "experience",
    "skills",
    "projects",
    "archive",
    "credentials",
    "pdf"
  ],
  "additionalProperties": false
}
